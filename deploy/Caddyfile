# Dossier, served from this server behind Cloudflare's proxy (the orange cloud), Cloudflare SSL/TLS mode "Full (strict)".
# Between Cloudflare and this server: a Let's Encrypt certificate Caddy gets and renews itself (Cloudflare's "Always
# Use HTTPS" must stay off, so the renewal check reaches the server over plain HTTP; Caddy redirects visitors to HTTPS
# itself), or a Cloudflare Origin certificate when /etc/caddy/cf-origin.pem and cf-origin-key.pem exist.
# deploy/setup.sh fills in @tls, dossier.example.com and /opt/orbio.
dossier.example.com {
	# @tls
	root * /opt/orbio/data/site
	encode zstd gzip
	file_server

	# the free API: readable from any site
	header /api/* Access-Control-Allow-Origin "*"
	# the numbers every page loads and polls each minute, rewritten on every pass. "private" matters: for a .js file
	# Cloudflare replaces a short max-age (even no-cache) with its Browser Cache TTL, 4 hours by default, and browsers
	# then showed market caps hours old on a refresh. It leaves private alone and doesn't cache at the edge; no-cache
	# makes the browser check its copy (a 304 when unchanged)
	@live path /api/v1/live.json /api/v1/live.js
	header @live Cache-Control "private, no-cache"
	# stylesheet and script URLs carry a content hash (?v=), so a copy never goes stale
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	@pages path / *.html
	header @pages Cache-Control "public, max-age=60"

	# only data/site is served: the index's database, logs and .env sit outside the root
	handle_errors {
		@missing expression {err.status_code} == 404
		handle @missing {
			rewrite * /404.html
			file_server
		}
	}
}

# www. goes to the bare domain (needs a proxied CNAME www -> the domain)
www.dossier.example.com {
	# @tls
	redir https://dossier.example.com{uri} permanent
}
