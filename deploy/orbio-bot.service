# The Dossier Telegram bot (lookups, passes, reports). Needs DOSSIER_BOT_TOKEN in .env.
# Installed by deploy/setup.sh, which replaces /opt/orbio with the checkout's real path.
[Unit]
Description=Dossier Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
User=orbio
WorkingDirectory=/opt/orbio
# local time for the logs and the daily digest (PROOF_DIGEST_HOUR); setup.sh sets it
Environment=TZ=Etc/UTC
# the runner restarts Python itself and holds the one-copy lock; systemd restarts the runner
ExecStart=/bin/sh /opt/orbio/run_bot.sh
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
